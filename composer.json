{
    "name": "praetoriantechnology/token-service",
    "description": "Tokening service",
    "type": "library",
    "license": ": MIT",
    "authors": [
        {
            "name": "Bartosz from Praetorian Technology",
            "email": "bartosz@praetorian.technology",
            "role": "Lead Developer"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-phpiredis": "*",
        "ext-igbinary": "*",
        "praetoriantechnology/cache-service": "^1.1",
        "symfony/uid": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "Praetorian\\TokenService\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Praetorian\\Tests\\TokenService\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@bitbucket.org:praetoriantechnology/cache-service.git"
        }
    ],
    "scripts": {
        "test": "./vendor/phpunit/phpunit/phpunit",
        "fix": "./vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "php-mock/php-mock": "^2.3",
        "php-mock/php-mock-phpunit": "^2.6",
        "friendsofphp/php-cs-fixer": "^2.17",
        "dg/bypass-finals": "^1.3"
    }
}
