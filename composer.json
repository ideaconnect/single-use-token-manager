{
    "name": "idct/single-use-token-manager",
    "description": "Single-use token manager built on the PSR-16 simple cache contract, with optional tag based invalidation.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "token",
        "single-use",
        "one-time",
        "psr-16",
        "simple-cache",
        "cache",
        "redis",
        "valkey"
    ],
    "authors": [
        {
            "name": "IDCT Bartosz Pachołek",
            "email": "bartosz+github@idct.tech",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "psr/simple-cache": "^3.0",
        "symfony/serializer": "^6.4 || ^7.0",
        "symfony/uid": "^6.4 || ^7.0",
        "symfony/validator": "^6.4 || ^7.0",
        "zircote/swagger-php": "^4.0 || ^5.0 || ^6.0"
    },
    "require-dev": {
        "behat/behat": "^3.31",
        "friendsofphp/php-cs-fixer": "^3.95",
        "idct/php-rapid-cache-client": "^1.0",
        "infection/infection": "^0.32",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/cache": "^6.4 || ^7.0",
        "symfony/property-access": "^6.4 || ^7.0"
    },
    "suggest": {
        "idct/php-rapid-cache-client": "PSR-16 Redis/Valkey cache with tag support, so clearAllTokens() drops only tokens instead of the whole pool",
        "symfony/cache": "Wrap any PSR-6 adapter as PSR-16 with Symfony\\Component\\Cache\\Psr16Cache"
    },
    "autoload": {
        "psr-4": {
            "IDCT\\SingleUseTokenManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IDCT\\Tests\\SingleUseTokenManager\\": "tests/"
        }
    },
    "scripts": {
        "cache:start": "docker compose up -d --wait",
        "cache:stop": "docker compose down",
        "cache:clean": "docker compose down -v",
        "test:unit": "XDEBUG_MODE=coverage ./vendor/bin/phpunit",
        "test:unit-no-coverage": "./vendor/bin/phpunit --no-coverage",
        "test:bdd:memory": "./vendor/bin/behat --strict --no-interaction --suite=array_cache",
        "test:bdd:redis": [
            "@cache:start",
            "./vendor/bin/behat --strict --no-interaction --suite=redis_no_tags",
            "./vendor/bin/behat --strict --no-interaction --suite=rapid_cache_tags"
        ],
        "test:bdd": [
            "@cache:start",
            "./vendor/bin/behat --strict --no-interaction"
        ],
        "test:mutation": "XDEBUG_MODE=coverage ./vendor/bin/infection --threads=max --no-progress --no-interaction",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=512M",
        "test": [
            "@analyse",
            "@test:unit",
            "@test:bdd",
            "@test:mutation"
        ],
        "fix": "./vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "lint": "./vendor/bin/php-cs-fixer fix --allow-risky=yes --dry-run --diff"
    },
    "scripts-descriptions": {
        "cache:start": "Start the Redis and Valkey containers used by the Behat suites",
        "cache:stop": "Stop the containers",
        "cache:clean": "Stop the containers and drop their volumes",
        "test:unit": "Run PHPUnit with coverage",
        "test:unit-no-coverage": "Run PHPUnit without coverage, for a quick loop",
        "test:bdd:memory": "Run the Behat suite that needs no container",
        "test:bdd:redis": "Run the Behat suites that need Redis and Valkey",
        "test:bdd": "Run every Behat suite",
        "test:mutation": "Run Infection mutation testing",
        "analyse": "Run PHPStan at the maximum level",
        "test": "Run static analysis, then unit, functional and mutation tests",
        "fix": "Apply the coding standard",
        "lint": "Report coding standard violations without changing anything"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true,
        "process-timeout": 0
    }
}
