# Keep the dist archive to the library itself. Everything below is development
# scaffolding that a consumer never runs, and shipping it only inflates every
# install.
#
# example.php is deliberately NOT ignored: the README points at it as a runnable
# tour, and it is worth having next to the code it demonstrates.
/.github                export-ignore
/features               export-ignore
/tests                  export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.dist.php export-ignore
/Makefile               export-ignore
/behat.yml              export-ignore
/docker-compose.yml     export-ignore
/infection.json         export-ignore
/phpstan.neon.dist      export-ignore
/phpunit.xml            export-ignore
